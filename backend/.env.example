# SIKopi Backend Configuration — COPY to .env and fill real values (never commit .env)
ADMIN_EMAIL=isi-email-admin-anda
ADMIN_PASSWORD=isi-password-kuat-anda
# Nomor WhatsApp admin/kasir (tanpa '+' / spasi, mis. 6281234567890).
# Dipakai tombol "Hubungi Admin" di halaman status pesanan & panel kasir.
ADMIN_WHATSAPP=6281234567890
# URL service wa-gateway (Baileys). Lokal: http://localhost:3001,
# di docker-compose: http://wa-gateway:3001
WA_GATEWAY_URL=http://localhost:3001
DATABASE_URL=sqlite:///./sikopi.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Bila dites dari HP/LAN, tambahkan origin perangkat, mis. ,http://192.168.1.10:5173
