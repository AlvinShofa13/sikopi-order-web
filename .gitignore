# ==========================================
# Root .gitignore for SIKopi Monorepo
# (FastAPI Backend + Vue.js Frontend)
# ==========================================

# Environments & Credentials
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local

# Database files (local SQLite persistence)
*.db
*.sqlite3
*.db-journal
backend/*.db
# Local DB backups & SQLite journals (never push: contain customer PII)
*.bak*
*.db-shm
*.db-wal
*.sqlite3-shm
*.sqlite3-wal

# Python & FastAPI
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
.venv/
venv/
ENV/
env/
backend/.venv/
backend/venv/

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE & OS
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# Testing & Logs
cypress/videos/
cypress/screenshots/
coverage/
*.log
