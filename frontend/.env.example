# Contoh: VITE_API_URL=http://localhost:8005/api (dev)
# Produksi (VPS): VITE_API_URL=https://api.domain-kamu.com/api
# Catatan: set juga di dashboard Vercel (Environment Variables) — nilai di
# sana menimpa file .env saat build.
VITE_API_URL=http://localhost:8005/api
# Link Google Form cadangan jika backend gagal diakses (kosongkan jika tidak dipakai)
VITE_GFORM_FALLBACK_URL=
